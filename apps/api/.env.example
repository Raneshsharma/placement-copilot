# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_copilot
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/placement_copilot

# Cache & Sessions
REDIS_URL=redis://localhost:6379

# Search & Vector Store
ELASTICSEARCH_URL=http://localhost:9200
WEAVIATE_URL=http://localhost:8080

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT Authentication
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars

# AI / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Service (internal)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=your-ai-service-secret-key

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=placement-copilot-uploads

# Observability
SENTRY_DSN=https://...@sentry.io/...
