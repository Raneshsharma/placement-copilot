# ============================================================
# Placement Copilot - Environment Variables
# ============================================================
# Copy this file to .env in the project root.
# NEVER commit .env or any file containing secrets to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#
# For Docker Compose, these can be set in .env or passed as:
#   cp .env.example .env && docker compose up -d
# ============================================================

# ------------------------------------------------------
# Environment Mode
# ------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------
# Used by NestJS API service
POSTGRES_PASSWORD=changeme_secure_password_32chars

# Connection string for Prisma (used by API)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/placement_copilot

# Direct URL for Prisma migrations (bypasses connection pooler)
DIRECT_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/placement_copilot

# ------------------------------------------------------
# Redis Cache
# ------------------------------------------------------
# Used for session caching, rate limiting, and job queues
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------
# Elasticsearch (Search)
# ------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------------------
# Weaviate (Vector Store)
# ------------------------------------------------------
WEAVIATE_URL=http://localhost:8081
WEAVIATE_API_KEY=

# ------------------------------------------------------
# AI / Anthropic (Claude)
# ------------------------------------------------------
# Required for AI-powered features (mock interviews, resume analysis, etc.)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------
# Used for securing API endpoints and session tokens
# Generate secrets: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_secret
JWT_REFRESH_SECRET=change_me_to_a_random_64_char_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------
# Google OAuth (Authentication)
# ------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/
# Enable Google+ API and configure OAuth consent screen
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------
# AWS S3 (File Storage)
# ------------------------------------------------------
# Used for storing resumes, cover letters, and uploaded files
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=placement-copilot-uploads
# Region: us-east-1 (or your preferred region)
AWS_REGION=us-east-1

# ------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------
# Comma-separated list of allowed origins
# In production, set this to your domain (e.g., https://placement-copilot.com)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------
# AI Service (Internal)
# ------------------------------------------------------
# Secret for authenticating API -> AI service communication
AI_SERVICE_SECRET=change_me_to_a_random_secret

# ------------------------------------------------------
# Observability / Error Tracking
# ------------------------------------------------------
# Sentry DSN for error tracking and performance monitoring
# Get your DSN at: https://sentry.io/
SENTRY_DSN=https://...@sentry.io/...

# Sample rate for traces (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------
# Firebase (Web Client)
# ------------------------------------------------------
# Create a Firebase project at: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------
# Observability - Client Side (Next.js)
# ------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
